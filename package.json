{
  "name": "website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "lint": "bash scripts/lint-checks.sh && oxlint",
    "lint:fix": "bash scripts/lint-checks.sh && oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "icons": "bash scripts/icons.sh",
    "taze": "taze",
    "ai-tools": "bash scripts/ai-tools-update.sh && bash scripts/shadcn-skill.sh",
    "ui:install": "shadcn-svelte add --yes",
    "ui:update": "shadcn-svelte update --all --yes",
    "ui:uninstall": "sh -c 'for c in \"$@\"; do rm -rf \"src/lib/components/ui/$c\"; done' --"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.52.0",
    "@rsvelte/oxlint-plugin": "0.2.6",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "bits-ui": "2.19.5",
    "cn": "0.4.0",
    "lucide-static": "1.52.0",
    "mode-watcher": "1.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tailwindcss": "1.14.0",
    "oxlint-tsgolint": "7.0.2003",
    "shadcn-svelte": "1.7.0",
    "simple-icons": "16.34.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "taze": "21.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.3.2"
  }
}
